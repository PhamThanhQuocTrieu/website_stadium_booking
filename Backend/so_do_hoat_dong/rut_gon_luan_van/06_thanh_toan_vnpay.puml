@startuml
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam activityFontSize 18
skinparam activityDiamondFontSize 17
skinparam titleFontSize 22
skinparam swimlaneTitleFontSize 18
skinparam arrowThickness 1.4
title So do hoat dong thanh toan booking qua VNPay

|Nguoi dung|
start
:Nhap thong tin nguoi nhan san;
:Chon dich vu/voucher neu co;
:Bam xac nhan va thanh toan;

|He thong|
:Xac thuc nguoi dung;

|Co so du lieu|
:Lay booking cho thanh toan;

|He thong|
if (Booking khong hop le\nhoac khong thuoc nguoi dung?) then (Co)
  :Tu choi thanh toan;
  stop
endif

if (Da het 3 phut giu cho?) then (Co)
  |Co so du lieu|
  :Huy booking tam;
  :Giai phong khung gio;
  |He thong|
  :Thong bao het thoi gian\ngiu cho, yeu cau dat lai;
  stop
endif

|He thong|
:Cap nhat thong tin nguoi nhan san;
:Tinh lai tong tien sau\ndich vu va voucher;

|Co so du lieu|
:Luu thong tin booking\nva giao dich dang cho;

|He thong|
:Tao duong dan thanh toan VNPay;

|Nguoi dung|
:Thanh toan tai cong VNPay;

|VNPay|
:Xu ly giao dich;
:Tra ket qua thanh toan ve he thong;

|He thong|
:Xac minh ket qua tu VNPay;
if (Thanh toan thanh cong?) then (Co)
  |Co so du lieu|
  :Cap nhat payment thanh cong;
  :Xac nhan booking;
  :Xoa thoi gian giu cho;
  :Ghi nhan voucher da su dung neu co;
  |He thong|
  :Thong bao dat san thanh cong;
else (Khong)
  |Co so du lieu|
  :Cap nhat payment that bai;
  :Huy booking neu con dang cho;
  :Giai phong khung gio;
  |He thong|
  :Thong bao thanh toan that bai;
endif

|Nguoi dung|
:Xem trang ket qua thanh toan;
stop
@enduml
